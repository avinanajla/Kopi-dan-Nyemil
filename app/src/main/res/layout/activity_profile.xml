<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:paddingHorizontal="20dp"
    android:paddingTop="28dp">

    <!-- Profile Header Banner -->
    <View
        android:id="@+id/viewProfileBanner"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_promo_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Avatar Placeholder -->
    <View
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_orange_circle"
        app:layout_constraintBottom_toBottomOf="@id/viewProfileBanner"
        app:layout_constraintEnd_toEndOf="@id/viewProfileBanner"
        app:layout_constraintStart_toStartOf="@id/viewProfileBanner"
        app:layout_constraintTop_toTopOf="@id/viewProfileBanner" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤"
        android:textSize="32sp"
        app:layout_constraintBottom_toBottomOf="@id/viewProfileBanner"
        app:layout_constraintEnd_toEndOf="@id/viewProfileBanner"
        app:layout_constraintStart_toStartOf="@id/viewProfileBanner"
        app:layout_constraintTop_toTopOf="@id/viewProfileBanner" />

    <!-- Greeting & Profile Card Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_container"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewProfileBanner">

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvProfileGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo Nama,"
            android:textColor="@color/coffee_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Profile Saya Title -->
        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Profile Saya"
            android:textColor="@color/coffee_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Profile Setting Subtitle -->
        <TextView
            android:id="@+id/tvProfileSetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Profile Setting"
            android:textColor="@color/coffee_text_secondary"
            android:textSize="14sp" />

        <!-- Name Input -->
        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:autofillHints="name"
            android:background="@drawable/bg_edit_text"
            android:hint="nama"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/coffee_text_primary"
            android:textColorHint="@color/coffee_hint"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Save Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnProfileSave"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_button_dark"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/coffee_dark"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textColor="#B0A8A0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Order"
            android:textColor="#B0A8A0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
