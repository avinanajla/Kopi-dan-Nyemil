<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:padding="28dp">

    <!-- Coffee Illustration Header Card -->
    <View
        android:id="@+id/viewHeroBg"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_promo_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo Circle inside Hero -->
    <View
        android:id="@+id/viewLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_orange_circle"
        app:layout_constraintBottom_toBottomOf="@id/viewHeroBg"
        app:layout_constraintEnd_toEndOf="@id/viewHeroBg"
        app:layout_constraintStart_toStartOf="@id/viewHeroBg"
        app:layout_constraintTop_toTopOf="@id/viewHeroBg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☕"
        android:textSize="36sp"
        app:layout_constraintBottom_toBottomOf="@id/viewLogo"
        app:layout_constraintEnd_toEndOf="@id/viewLogo"
        app:layout_constraintStart_toStartOf="@id/viewLogo"
        app:layout_constraintTop_toTopOf="@id/viewLogo" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Kopi dan Nyemil"
        android:textColor="@color/coffee_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewHeroBg" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Discover artisanal coffee &amp; delicious pastry"
        android:textColor="@color/coffee_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Start Now Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartNow"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_button_dark"
        android:text="Start now"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
