<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:padding="28dp">

    <!-- Header Illustration -->
    <View
        android:id="@+id/viewLoginHero"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_promo_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☕✨"
        android:textSize="44sp"
        app:layout_constraintBottom_toBottomOf="@id/viewLoginHero"
        app:layout_constraintEnd_toEndOf="@id/viewLoginHero"
        app:layout_constraintStart_toStartOf="@id/viewLoginHero"
        app:layout_constraintTop_toTopOf="@id/viewLoginHero" />

    <!-- Login Form Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_container"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewLoginHero">

        <!-- Title -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login User"
            android:textColor="@color/coffee_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Welcome back, please login to continue"
            android:textColor="@color/coffee_text_secondary"
            android:textSize="13sp" />

        <!-- Username Input -->
        <EditText
            android:id="@+id/etLoginUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:autofillHints="username"
            android:background="@drawable/bg_edit_text"
            android:hint="username"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/coffee_text_primary"
            android:textColorHint="@color/coffee_hint"
            android:textSize="15sp" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:autofillHints="password"
            android:background="@drawable/bg_edit_text"
            android:hint="password"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/coffee_text_primary"
            android:textColorHint="@color/coffee_hint"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Login Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLoginSubmit"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_button_dark"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
